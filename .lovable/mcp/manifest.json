      {
        "name": "create_occurrence",
        "title": "Register incident / non-conformity",
        "description": "Draft and then register an occurrence (incident, near miss, non-conformity or safety observation). Called without `confirm` it saves nothing and returns a draft for the user to review; call it again with confirm=true only after the user explicitly approves. The type cannot be changed afterwards. Requires editor permission on the IC & NC module.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "incident",
                "near_miss",
                "non_conformity",
                "safety_observation"
              ],
              "description": "Occurrence type — immutable after creation."
            },
            "severity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "description": "Severity level."
            },
            "description": {
              "type": "string",
              "description": "What happened."
            },
            "occurred_at": {
              "type": "string",
              "description": "Date it happened (YYYY-MM-DD)."
            },
            "location": {
              "type": "string",
              "description": "Where it happened."
            },
            "with_leave": {
              "type": "boolean",
              "default": false,
              "description": "Whether it caused time off work."
            },
            "lost_days": {
              "type": "integer",
              "minimum": 0,
              "description": "Lost days, when there was time off work."
            },
            "confirm": {
              "type": "boolean",
              "default": false,
              "description": "Set to true ONLY after the user has explicitly approved the draft. With false (default) nothing is saved — a draft preview of the occurrence is returned for review."
            }
          },
          "required": [
            "type",
            "severity",
            "description",
            "occurred_at"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_calendar_event",
        "title": "Create calendar event",
        "description": "Draft and then create an HSE calendar entry (event, campaign, audit, meeting or internal training). Called without `confirm` it saves nothing and returns a draft for the user to review; call it again with confirm=true only after the user explicitly approves. Requires editor permission on the calendar module.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "description": "Event title."
            },
            "area": {
              "type": "string",
              "enum": [
                "meio_ambiente",
                "seguranca",
                "saude",
                "geral"
              ],
              "description": "HSE area."
            },
            "category": {
              "type": "string",
              "enum": [
                "evento",
                "campanha",
                "auditoria",
                "reuniao",
                "treinamento_interno",
                "outro"
              ],
              "description": "Event category."
            },
            "starts_at": {
              "type": "string",
              "description": "Start date/time (YYYY-MM-DD or ISO timestamp)."
            },
            "ends_at": {
              "type": "string",
              "description": "End date/time (YYYY-MM-DD or ISO timestamp)."
            },
            "all_day": {
              "type": "boolean",
              "default": true
            },
            "location": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "confirm": {
              "type": "boolean",
              "default": false,
              "description": "Set to true ONLY after the user has explicitly approved the draft. With false (default) nothing is saved — a draft preview of the calendar event is returned for review."
            }
          },
          "required": [
            "title",
            "area",
            "category",
            "starts_at"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_corrective_action",
        "title": "Create corrective action (5W2H)",
        "description": "Create a 5W2H corrective action linked to an existing occurrence. Requires editor permission on the IC & NC module.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "occurrence_id": {
              "type": "string",
              "description": "ID of the occurrence this action belongs to."
            },
            "description": {
              "type": "string",
              "description": "What will be done (What)."
            },
            "why": {
              "type": "string",
              "description": "Why it will be done."
            },
            "where_location": {
              "type": "string",
              "description": "Where it will be done."
            },
            "how_method": {
              "type": "string",
              "description": "How it will be done."
            },
            "due_date": {
              "type": "string",
              "description": "Deadline (YYYY-MM-DD)."
            },
            "control_hierarchy": {
              "type": "string",
              "enum": [
                "elimination",
                "substitution",
                "engineering",
                "administrative",
                "ppe"
              ],
              "description": "Hierarchy of controls level."
            }
          },
          "required": [
            "occurrence_id",
            "description"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "register_service_completion",
        "title": "Register periodic service completion",
        "description": "Record that a periodic service was performed and recalculate its next due date from the service frequency. Requires editor permission on the periodic services module.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "service_id": {
              "type": "string",
              "description": "ID of the periodic service."
            },
            "done_at": {
              "type": "string",
              "description": "Date it was performed (YYYY-MM-DD)."
            },
            "supplier": {
              "type": "string",
              "description": "Supplier/provider that performed it."
            },
            "notes": {
              "type": "string"
            },
            "realization_type": {
              "type": "string",
              "enum": [
                "scheduled",
                "corrective"
              ],
              "default": "scheduled",
              "description": "'scheduled' when done as planned, 'corrective' when triggered by a failure."
            },
            "failure_description": {
              "type": "string",
              "description": "Failure description for corrective completions."
            }
          },
          "required": [
            "service_id",
            "done_at"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
